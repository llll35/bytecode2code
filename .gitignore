# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# ...except the compiled test corpus: these are fixtures, not build artefacts,
# and cannot be regenerated without the exact interpreter versions.
!tests/samples/*.pyc
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test / tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors and OS ---
.idea/
.vscode/
*.swp
*.orig
.DS_Store
Thumbs.db

# --- Generated decompiler output ---
debug/outputs/
*.dis.txt
tmp.txt
junk.txt

# --- Scratch probes (throwaway debugging scripts, kept out of the tree) ---
_scratch/

# --- Vendored interpreters (download on demand; see README) ---
embed_python/

# --- Local tooling state (not project content) ---
.workbuddy-ai/
.easyclaw/
.venv.bak
*.bak
*.bak.*
opencode_session.bat
